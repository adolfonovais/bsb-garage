# Copie este arquivo para ".env" e preencha com os valores reais.
# NUNCA commite o arquivo ".env" (já está no .gitignore).

# String de conexão do banco Postgres (Supabase: Project Settings > Database > Connection string > "URI").
# Use a versão "Transaction pooler" (porta 6543) aqui — é o que a aplicação usa em produção.
# Para rodar migrations (migrate deploy / db push), use temporariamente a versão "Session pooler"
# (porta 5432, mesmo host do pooler) — a conexão "Direct connection" costuma ser só IPv6 e falha
# em ambientes sem essa saída; o "Transaction pooler" não suporta os locks que as migrations usam.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres"

# Chave secreta do NextAuth — gere uma com: npx auth secret
AUTH_SECRET=""

# URL pública do site (local: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"

# Supabase (para upload de fotos das Ordens de Serviço)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# E-mail (SMTP) para notificar cliente quando a OS fica pronta — opcional na Fase 1
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="BSB Garage Martelinho de Ouro <naoresponda@bsbgarage.com.br>"
