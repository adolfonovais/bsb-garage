// Schema do banco de dados do sistema BSB Garage Martelinho de Ouro.
// Rodar `npx prisma migrate dev` após configurar DATABASE_URL no .env
//
// Este banco é compartilhado com outro projeto (Supabase "Vila Maytrea
// Gestão", da pousada) — por isso todo model/enum vive isolado no schema
// Postgres "bsb_garage" (não no "public"), via multiSchema do Prisma. Isso
// não tem nenhum contato com as tabelas do outro projeto, só compartilha a
// mesma instância/armazenamento em disco.

generator client {
  provider = "prisma-client-js"
}

// A partir do Prisma 7, a URL de conexão não fica mais aqui — ela é configurada
// em prisma.config.ts (para o CLI) e via driver adapter no PrismaClient (ver src/lib/prisma.ts).
datasource db {
  provider = "postgresql"
  schemas  = ["bsb_garage"]
}

// ---------- Usuários / Auth ----------

enum PapelUsuario {
  ADMIN
  FUNCIONARIO

  @@schema("bsb_garage")
}

model Usuario {
  id           String       @id @default(cuid())
  nome         String
  email        String       @unique
  senhaHash    String
  papel        PapelUsuario @default(FUNCIONARIO)
  ativo        Boolean      @default(true)
  createdAt    DateTime     @default(now())

  orcamentos     Orcamento[]
  ordensServico  OrdemServico[]

  @@schema("bsb_garage")
}

// ---------- Clientes / Veículos ----------

model Cliente {
  id          String   @id @default(cuid())
  nome        String
  cpf         String?
  telefone    String?
  email       String?
  // Endereço estruturado — usado na emissão de NFS-e (o webservice do DF
  // exige logradouro/número/bairro/CEP/cidade/UF separados, não um texto
  // livre). Cidade/UF default pra "Brasília"/"DF" no formulário, mas
  // ficam editáveis pra clientes de fora (o código do município é
  // resolvido pela API do IBGE na hora de emitir, não fica fixo).
  cep         String?
  logradouro  String?
  numero      String?
  bairro      String?
  cidade      String?
  uf          String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  veiculos      Veiculo[]
  orcamentos    Orcamento[]
  ordensServico OrdemServico[]

  @@index([nome])
  @@schema("bsb_garage")
}

model Veiculo {
  id        String   @id @default(cuid())
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  modelo    String
  placa     String?
  cor       String?
  ano       Int?
  createdAt DateTime @default(now())

  orcamentos    Orcamento[]
  ordensServico OrdemServico[]

  @@index([placa])
  @@index([clienteId])
  @@schema("bsb_garage")
}

// ---------- Catálogo de serviços ----------

model TipoServico {
  id         String   @id @default(cuid())
  nome       String   @unique
  precoBase  Decimal? @db.Decimal(10, 2)
  ativo      Boolean  @default(true)

  itensOrcamento OrcamentoItem[]
  itensOS        OrdemServicoItem[]

  @@schema("bsb_garage")
}

// ---------- Numeração sequencial (Orçamento / OS) ----------

model Contador {
  id     String @id @default(cuid())
  chave  String // "ORCAMENTO" | "OS"
  ano    Int
  ultimo Int    @default(0)

  @@unique([chave, ano])
  @@schema("bsb_garage")
}

// ---------- Orçamento ----------

enum StatusOrcamento {
  PENDENTE
  APROVADO
  RECUSADO
  EXPIRADO

  @@schema("bsb_garage")
}

model Orcamento {
  id            String          @id @default(cuid())
  numero        Int
  ano           Int
  clienteId     String
  cliente       Cliente         @relation(fields: [clienteId], references: [id])
  veiculoId     String?
  veiculo       Veiculo?        @relation(fields: [veiculoId], references: [id])
  data          DateTime        @default(now())
  validadeDias  Int             @default(30)
  status        StatusOrcamento @default(PENDENTE)
  observacoes   String?
  valorTotal    Decimal         @default(0) @db.Decimal(10, 2)
  criadoPorId   String?
  criadoPor     Usuario?        @relation(fields: [criadoPorId], references: [id])
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  itens         OrcamentoItem[]
  ordensServico OrdemServico[]

  @@unique([ano, numero])
  @@schema("bsb_garage")
}

model OrcamentoItem {
  id            String       @id @default(cuid())
  orcamentoId   String
  orcamento     Orcamento    @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  tipoServicoId String?
  tipoServico   TipoServico? @relation(fields: [tipoServicoId], references: [id])
  descricao     String
  quantidade    Decimal      @default(1) @db.Decimal(10, 2)
  valorUnit     Decimal      @db.Decimal(10, 2)
  valorTotal    Decimal      @db.Decimal(10, 2)
  ordem         Int          @default(0)

  @@schema("bsb_garage")
}

// ---------- Ordem de Serviço ----------

enum StatusOS {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_PECA
  CONCLUIDA
  ENTREGUE
  CANCELADA

  @@schema("bsb_garage")
}

enum TipoFoto {
  ANTES
  DEPOIS

  @@schema("bsb_garage")
}

model OrdemServico {
  id                    String        @id @default(cuid())
  numero                Int
  ano                   Int
  origemOrcamentoId     String?
  origemOrcamento       Orcamento?    @relation(fields: [origemOrcamentoId], references: [id])
  clienteId             String
  cliente               Cliente       @relation(fields: [clienteId], references: [id])
  veiculoId             String?
  veiculo               Veiculo?      @relation(fields: [veiculoId], references: [id])
  dataEntrada           DateTime      @default(now())
  dataSaidaPrevista     DateTime?
  dataSaidaReal         DateTime?
  status                StatusOS      @default(ABERTA)
  formaPagamento        String?
  valorTotal            Decimal       @default(0) @db.Decimal(10, 2)
  oficinaTerceirizadaId String?
  oficinaTerceirizada   OficinaTerceirizada? @relation(fields: [oficinaTerceirizadaId], references: [id])
  observacoes           String?
  criadoPorId           String?
  criadoPor             Usuario?      @relation(fields: [criadoPorId], references: [id])
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  // NFS-e Nacional (ADN/SEFIN) — preenchidos quando a nota é emitida com
  // sucesso pelo webservice do governo (ver src/lib/nfse.ts).
  nfseChaveAcesso String?
  nfseSerie       String?
  nfseNumero      Int?
  nfseXml         String?   @db.Text
  nfseEmitidaEm   DateTime?
  nfseAmbiente    String? // "homologacao" | "producao" — em qual ambiente saiu
  nfseErro        String?   @db.Text
  // URL oficial (governo/prefeitura) pra visualizar a NFS-e — o padrão
  // nacional não gera PDF, e sim uma página de visualização com QR code
  // de verificação (funciona como o "PDF" da nota). Buscada via
  // ConsultarUrlNfse logo após a emissão; pode ficar vazia se essa
  // consulta falhar (a NFS-e em si já está emitida e válida mesmo assim).
  nfseUrlVisualizacao String? @db.Text

  itens       OrdemServicoItem[]
  pagamentos  Pagamento[]
  fotos       FotoOS[]
  contas      ContaFinanceira[]
  repasses    RepasseOficina[]
  movEstoque  MovimentacaoEstoque[]

  @@unique([ano, numero])
  @@schema("bsb_garage")
}

model OrdemServicoItem {
  id            String       @id @default(cuid())
  osId          String
  os            OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  tipoServicoId String?
  tipoServico   TipoServico? @relation(fields: [tipoServicoId], references: [id])
  descricao     String // parte do carro / descrição do serviço
  quantidade    Decimal      @default(1) @db.Decimal(10, 2)
  valorUnit     Decimal      @db.Decimal(10, 2)
  valorTotal    Decimal      @db.Decimal(10, 2)
  ordem         Int          @default(0)

  @@schema("bsb_garage")
}

model Pagamento {
  id             String       @id @default(cuid())
  osId           String
  os             OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  data           DateTime     @default(now())
  descricao      String?
  valor          Decimal      @db.Decimal(10, 2)
  formaPagamento String?
  createdAt      DateTime     @default(now())

  @@schema("bsb_garage")
}

model FotoOS {
  id        String   @id @default(cuid())
  osId      String
  os        OrdemServico @relation(fields: [osId], references: [id], onDelete: Cascade)
  url       String
  tipo      TipoFoto
  createdAt DateTime @default(now())

  @@schema("bsb_garage")
}

// ---------- Oficinas terceirizadas ----------

enum StatusRepasse {
  EM_ANDAMENTO
  ENTREGUE
  CANCELADO

  @@schema("bsb_garage")
}

enum StatusPagamentoOficina {
  PENDENTE
  PAGO

  @@schema("bsb_garage")
}

model OficinaTerceirizada {
  id       String  @id @default(cuid())
  nome     String  @unique
  contato  String?
  telefone String?
  ativo    Boolean @default(true)

  ordensServico OrdemServico[]
  repasses      RepasseOficina[]

  @@schema("bsb_garage")
}

model RepasseOficina {
  id                     String                  @id @default(cuid())
  oficinaId              String
  oficina                OficinaTerceirizada     @relation(fields: [oficinaId], references: [id])
  osId                   String?
  os                     OrdemServico?           @relation(fields: [osId], references: [id])
  dataEntrada            DateTime
  dataSaida              DateTime?
  carro                  String
  placa                  String?
  tipoServico            String
  qtdPecas               Int                     @default(1)
  servicoAdicional       String?
  valorCobrado           Decimal                 @db.Decimal(10, 2) // cobrado do cliente
  custoOficina           Decimal                 @db.Decimal(10, 2) // pago à oficina
  outrosCustos           Decimal?                @db.Decimal(10, 2)
  polimento              Boolean                 @default(false)
  custoTotal             Decimal                 @db.Decimal(10, 2) // custoOficina + outrosCustos
  lucro                  Decimal                 @db.Decimal(10, 2) // valorCobrado - custoTotal
  status                 StatusRepasse           @default(EM_ANDAMENTO)
  statusPagamentoOficina StatusPagamentoOficina  @default(PENDENTE)
  createdAt              DateTime                @default(now())

  contas ContaFinanceira[]

  @@schema("bsb_garage")
}

// ---------- Estoque ----------

enum TipoMovimentoEstoque {
  ENTRADA
  SAIDA

  @@schema("bsb_garage")
}

model Peca {
  id               String  @id @default(cuid())
  nome             String  @unique
  unidade          String  @default("un")
  quantidadeAtual  Decimal @default(0) @db.Decimal(10, 2)
  quantidadeMinima Decimal @default(0) @db.Decimal(10, 2)
  custoUnitario    Decimal? @db.Decimal(10, 2)

  movimentacoes MovimentacaoEstoque[]

  @@schema("bsb_garage")
}

model MovimentacaoEstoque {
  id          String               @id @default(cuid())
  pecaId      String
  peca        Peca                 @relation(fields: [pecaId], references: [id])
  tipo        TipoMovimentoEstoque
  quantidade  Decimal              @db.Decimal(10, 2)
  data        DateTime             @default(now())
  osId        String?
  os          OrdemServico?        @relation(fields: [osId], references: [id])
  observacao  String?

  @@schema("bsb_garage")
}

// ---------- Financeiro ----------

enum TipoConta {
  PAGAR
  RECEBER

  @@schema("bsb_garage")
}

enum StatusConta {
  ABERTA
  PAGA
  ATRASADA
  CANCELADA

  @@schema("bsb_garage")
}

model ContaFinanceira {
  id              String      @id @default(cuid())
  tipo            TipoConta
  descricao       String
  valor           Decimal     @db.Decimal(10, 2)
  dataVencimento  DateTime
  dataPagamento   DateTime?
  status          StatusConta @default(ABERTA)
  categoria       String?
  osId            String?
  os              OrdemServico? @relation(fields: [osId], references: [id])
  repasseId       String?
  repasse         RepasseOficina? @relation(fields: [repasseId], references: [id])
  createdAt       DateTime    @default(now())

  @@schema("bsb_garage")
}

// ---------- Configuração da empresa ----------

model EmpresaConfig {
  id           Int     @id @default(1)
  nome         String  @default("BSB Garage Martelinho de Ouro")
  razaoSocial  String?
  cnpj         String?
  ie           String?
  telefones    String?
  endereco     String?
  cidadeUf     String  @default("Brasília - DF")

  @@schema("bsb_garage")
}
